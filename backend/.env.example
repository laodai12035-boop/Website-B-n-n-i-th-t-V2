# ==========================================
# ENVIRONMENT VARIABLES — Copy sang .env và điền giá trị thật
# ==========================================

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-this-in-production

# Database (XAMPP MySQL defaults)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=noi_that_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# Email (Gmail SMTP — Điền email và Mật khẩu ứng dụng 16 ký tự để gửi mail thật)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_app_password
MAIL_DEFAULT_SENDER="Website Nội Thất V2 <your_gmail@gmail.com>"
MAIL_MOCK=false
